<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>BeatStream — Real Music Streaming</title>
    <!-- Firebase SDKs (v9) -->
    <script type="module">
        // Import Firebase modules dynamically
        import { initializeApp } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-app.js";
        import { getAuth, signInWithEmailAndPassword, createUserWithEmailAndPassword, signInWithPopup, GoogleAuthProvider, onAuthStateChanged, signOut } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-auth.js";
        import { getFirestore, collection, doc, setDoc, getDocs, query, where, orderBy, limit, updateDoc, arrayUnion, arrayRemove, deleteDoc, onSnapshot, getDoc, increment } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore.js";
        import { getStorage, ref, uploadBytesResumable, getDownloadURL, deleteObject } from "https://www.gstatic.com/firebasejs/10.7.1/firebase-storage.js";

        // ==================== YOUR FIREBASE CONFIG ====================
        // Replace with your own Firebase project config (from Firebase Console)
        const firebaseConfig = {
            apiKey: "YOUR_API_KEY",
            authDomain: "YOUR_AUTH_DOMAIN",
            projectId: "YOUR_PROJECT_ID",
            storageBucket: "YOUR_STORAGE_BUCKET",
            messagingSenderId: "YOUR_SENDER_ID",
            appId: "YOUR_APP_ID"
        };
        // ===============================================================

        // Initialize Firebase
        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);
        const storage = getStorage(app);
        const googleProvider = new GoogleAuthProvider();

        // Global state
        let currentUser = null;
        let currentSong = null;
        let isPlaying = false;
        let audio = new Audio();
        let currentPlaylist = []; // array of song objects
        let currentIndex = 0;
        let songsCache = []; // all songs from Firestore
        let artistsCache = [];
        let playlistsCache = [];
        let favoritesCache = [];

        // DOM elements will be injected; we'll use innerHTML for views
        let currentView = 'home';
        let fullPlayerOpen = false;
        let darkMode = true;

        // Helper: show toast
        function showToast(msg, isError = false) {
            const toast = document.createElement('div');
            toast.innerText = msg;
            toast.style.position = 'fixed';
            toast.style.bottom = '120px';
            toast.style.left = '50%';
            toast.style.transform = 'translateX(-50%)';
            toast.style.backgroundColor = isError ? '#ff4d4d' : '#333';
            toast.style.color = 'white';
            toast.style.padding = '8px 16px';
            toast.style.borderRadius = '40px';
            toast.style.zIndex = '1000';
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 2500);
        }

        // Load all songs from Firestore (real-time)
        async function loadSongs() {
            const q = query(collection(db, "songs"), orderBy("createdAt", "desc"));
            const snapshot = await getDocs(q);
            songsCache = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
            render();
        }

        async function loadArtists() {
            const snapshot = await getDocs(collection(db, "artists"));
            artistsCache = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
        }

        async function loadPlaylists() {
            if (!currentUser) return;
            const q = query(collection(db, "playlists"), where("userId", "==", currentUser.uid));
            const snapshot = await getDocs(q);
            playlistsCache = snapshot.docs.map(doc => ({ id: doc.id, ...doc.data() }));
        }

        async function loadFavorites() {
            if (!currentUser) return;
            const favDoc = await getDoc(doc(db, "favorites", currentUser.uid));
            favoritesCache = favDoc.exists() ? favDoc.data().songIds || [] : [];
        }

        // Play song by id
        async function playSongById(songId) {
            const song = songsCache.find(s => s.id === songId);
            if (!song) return;
            currentSong = song;
            audio.src = song.url;
            audio.play().then(() => {
                isPlaying = true;
                render();
                // increment stream count
                const songRef = doc(db, "songs", songId);
                updateDoc(songRef, { streams: increment(1) });
                // add to recent
                if (currentUser) {
                    const recentRef = doc(db, "recent", currentUser.uid);
                    setDoc(recentRef, { songIds: arrayUnion(songId) }, { merge: true });
                }
            }).catch(e => showToast("Playback error: " + e.message, true));
            audio.onended = () => {
                isPlaying = false;
                render();
            };
            currentPlaylist = songsCache;
            currentIndex = currentPlaylist.findIndex(s => s.id === songId);
            render();
        }

        async function nextSong() {
            if (currentIndex < currentPlaylist.length - 1) {
                currentIndex++;
                await playSongById(currentPlaylist[currentIndex].id);
            }
        }
        async function prevSong() {
            if (currentIndex > 0) {
                currentIndex--;
                await playSongById(currentPlaylist[currentIndex].id);
            }
        }

        // Upload song to Storage and Firestore
        async function uploadSong(file, title, artist, genre, coverFile) {
            if (!currentUser) return showToast("Login first", true);
            showToast("Uploading...");
            const storageRef = ref(storage, `songs/${Date.now()}_${file.name}`);
            const uploadTask = uploadBytesResumable(storageRef, file);
            uploadTask.on('state_changed', null, null, async () => {
                const downloadURL = await getDownloadURL(uploadTask.snapshot.ref);
                let coverURL = "";
                if (coverFile) {
                    const coverRef = ref(storage, `covers/${Date.now()}_${coverFile.name}`);
                    const coverUpload = await uploadBytesResumable(coverRef, coverFile);
                    coverURL = await getDownloadURL(coverUpload.snapshot.ref);
                } else {
                    coverURL = "https://picsum.photos/200/200";
                }
                await setDoc(doc(collection(db, "songs")), {
                    title, artist, genre, url: downloadURL, cover: coverURL,
                    streams: 0, downloads: 0, userId: currentUser.uid,
                    createdAt: new Date().toISOString()
                });
                showToast("Upload complete!");
                loadSongs();
            });
        }

        // Authentication UI
        function renderAuth() {
            return `
                <div style="max-width:400px; margin:2rem auto; background:rgba(20,20,35,0.8); backdrop-filter:blur(16px); border-radius:2rem; padding:2rem;">
                    <h1 style="color:var(--orange);">BeatStream</h1>
                    <input type="email" id="loginEmail" placeholder="Email" style="width:100%; margin:0.5rem 0; padding:0.8rem; border-radius:2rem;">
                    <input type="password" id="loginPassword" placeholder="Password" style="width:100%; margin:0.5rem 0; padding:0.8rem; border-radius:2rem;">
                    <button id="doLogin" class="btn-primary" style="width:100%;">Login</button>
                    <button id="doSignup" class="btn-outline" style="width:100%; margin-top:0.5rem;">Sign Up</button>
                    <button id="googleLogin" class="btn-outline" style="width:100%; margin-top:0.5rem;"><i class="fab fa-google"></i> Continue with Google</button>
                </div>
            `;
        }

        // Main render function
        function render() {
            const root = document.getElementById('root');
            if (!currentUser) {
                root.innerHTML = renderAuth();
                document.getElementById('doLogin')?.addEventListener('click', async () => {
                    const email = document.getElementById('loginEmail').value;
                    const pwd = document.getElementById('loginPassword').value;
                    try {
                        await signInWithEmailAndPassword(auth, email, pwd);
                    } catch(e) { showToast(e.message, true); }
                });
                document.getElementById('doSignup')?.addEventListener('click', async () => {
                    const email = document.getElementById('loginEmail').value;
                    const pwd = document.getElementById('loginPassword').value;
                    try {
                        await createUserWithEmailAndPassword(auth, email, pwd);
                        showToast("Account created! Welcome.");
                    } catch(e) { showToast(e.message, true); }
                });
                document.getElementById('googleLogin')?.addEventListener('click', async () => {
                    try {
                        await signInWithPopup(auth, googleProvider);
                    } catch(e) { showToast(e.message, true); }
                });
                return;
            }
            // Main app UI
            root.innerHTML = `
                <div class="app">
                    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:1rem;">
                        <div><i class="fas fa-music" style="color:var(--orange); font-size:1.8rem;"></i> <span style="font-weight:800; font-size:1.5rem;">BeatStream</span></div>
                        <div><i class="fas ${darkMode ? 'fa-sun' : 'fa-moon'}" style="cursor:pointer;" id="themeToggle"></i> <i class="fas fa-sign-out-alt" style="margin-left:1rem; cursor:pointer;" id="logoutBtn"></i></div>
                    </div>
                    <div id="viewContainer"></div>
                </div>
                ${renderMiniPlayer()}
                ${renderBottomNav()}
                ${fullPlayerOpen ? renderFullPlayer() : ''}
            `;
            renderCurrentView();
            attachGlobalEvents();
        }

        function renderCurrentView() {
            const container = document.getElementById('viewContainer');
            if (!container) return;
            if (currentView === 'home') container.innerHTML = renderHome();
            else if (currentView === 'search') container.innerHTML = renderSearch();
            else if (currentView === 'library') renderLibraryAsync(container);
            else if (currentView === 'upload') container.innerHTML = renderUpload();
            else if (currentView === 'profile') container.innerHTML = renderProfile();
            else container.innerHTML = renderHome();
        }

        function renderHome() {
            const trending = [...songsCache].sort((a,b) => b.streams - a.streams).slice(0,6);
            return `
                <input type="text" id="globalSearch" placeholder="Search songs..." style="width:100%; margin-bottom:1rem; padding:0.7rem; border-radius:2rem;">
                <h2 class="section-title">🔥 Trending</h2>
                <div class="horizontal-scroll">${trending.map(s => songCard(s)).join('')}</div>
                <h2 class="section-title">🎧 For You</h2>
                <div class="horizontal-scroll">${songsCache.slice(0,6).map(s => songCard(s)).join('')}</div>
                <h2 class="section-title">⭐ Featured Artists</h2>
                <div class="horizontal-scroll">${artistsCache.slice(0,4).map(a => artistCard(a)).join('')}</div>
                <h2 class="section-title">🎶 Genres</h2>
                <div style="display:flex; gap:0.5rem; flex-wrap:wrap;">${['Afrobeats','Gospel','Rap','Amapiano','R&B'].map(g => `<span class="genre-pill" data-genre="${g}">${g}</span>`).join('')}</div>
            `;
        }

        function songCard(song) {
            const isFav = favoritesCache.includes(song.id);
            return `<div class="song-card" data-song-id="${song.id}">
                <img src="${song.cover}" loading="lazy">
                <div class="track-name">${song.title}</div>
                <div class="track-artist">${song.artist}</div>
                <div style="display:flex; justify-content:space-between; margin-top:0.3rem;">
                    <i class="fas ${isFav ? 'fa-heart' : 'fa-heart-o'}" style="color:${isFav ? 'var(--orange)' : '#aaa'}; cursor:pointer;" data-fav="${song.id}"></i>
                    <i class="fas fa-play-circle" style="color:var(--orange); cursor:pointer;" data-play="${song.id}"></i>
                </div>
            </div>`;
        }

        function artistCard(artist) {
            return `<div class="artist-card" data-artist-id="${artist.id}">
                <img src="${artist.cover}"><div>${artist.name} ${artist.verified ? '<i class="fas fa-check-circle" style="color:var(--orange);"></i>' : ''}</div>
                <div style="font-size:0.7rem;">${artist.followers || 0} followers</div>
            </div>`;
        }

        function renderSearch() {
            return `<input type="text" id="searchInput" placeholder="Search by title or artist..." style="width:100%; margin-bottom:1rem;"><div id="searchResults" class="grid-2"></div>`;
        }

        async function renderLibraryAsync(container) {
            await loadFavorites();
            const favSongs = songsCache.filter(s => favoritesCache.includes(s.id));
            container.innerHTML = `
                <h2>❤️ Liked Songs (${favSongs.length})</h2>
                <div class="grid-2">${favSongs.map(s => songCard(s)).join('')}</div>
                <h2>📀 My Playlists</h2>
                <button id="createPlaylistBtn" class="btn-primary">+ Create Playlist</button>
                <div id="playlistsList" class="grid-2"></div>
            `;
            const playlistsDiv = document.getElementById('playlistsList');
            playlistsDiv.innerHTML = playlistsCache.map(p => `<div class="glass-card playlist-item" data-playlist-id="${p.id}" style="padding:1rem;">${p.name} (${p.songs?.length || 0})</div>`).join('');
            document.getElementById('createPlaylistBtn')?.addEventListener('click', async () => {
                const name = prompt("Playlist name");
                if (name && currentUser) {
                    await setDoc(doc(collection(db, "playlists")), {
                        name, userId: currentUser.uid, songs: [], createdAt: new Date()
                    });
                    loadPlaylists();
                    render();
                }
            });
        }

        function renderUpload() {
            return `<div class="glass-card" style="padding:2rem; text-align:center;">
                <h2>Upload Your Music</h2>
                <div id="dropZone" style="border:2px dashed var(--orange); border-radius:2rem; padding:2rem; margin:1rem 0;">Drag & Drop MP3 here or click</div>
                <input type="file" id="songFile" accept="audio/mpeg" hidden>
                <input type="text" id="songTitle" placeholder="Song Title"><input type="text" id="songArtist" placeholder="Artist Name"><select id="songGenre"><option>Afrobeats</option><option>Gospel</option><option>Rap</option><option>Amapiano</option></select>
                <input type="file" id="coverImage" accept="image/*"><button id="uploadSongBtn" class="btn-primary">Upload</button>
                <div id="uploadProgress" style="width:100%; background:#333; margin-top:1rem;"><div id="progressBar" style="width:0%; background:var(--orange); height:6px;"></div></div>
            </div>`;
        }

        function renderProfile() {
            return `<div class="glass-card" style="padding:2rem;"><i class="fas fa-user-circle fa-3x"></i><h3>${currentUser.email}</h3><button id="logoutProfileBtn" class="btn-outline">Logout</button></div>`;
        }

        function renderMiniPlayer() {
            if (!currentSong) return '';
            return `<div class="mini-player" id="miniPlayer"><img src="${currentSong.cover}"><div><div>${currentSong.title}</div><div style="font-size:0.7rem;">${currentSong.artist}</div></div><i class="fas ${isPlaying ? 'fa-pause' : 'fa-play'}" id="miniPlayPause"></i><i class="fas fa-expand" id="expandPlayer"></i></div>`;
        }

        function renderFullPlayer() {
            return `<div class="player-modal" id="fullPlayerModal">
                <div style="text-align:center;">
                    <img src="${currentSong.cover}" id="fullCover" style="width:250px; border-radius:1rem;">
                    <h2>${currentSong.title}</h2><p>${currentSong.artist}</p>
                    <div style="display:flex; gap:4px; justify-content:center; margin:1rem;">${Array(8).fill().map(()=>'<div class="equalizer-bar"></div>').join('')}</div>
                    <input type="range" id="fullProgress" style="width:80%;"><div id="fullTime"></div>
                    <div><button id="fullPlayPause"><i class="fas ${isPlaying ? 'fa-pause' : 'fa-play'}"></i></button>
                    <button id="fullPrev"><i class="fas fa-backward"></i></button>
                    <button id="fullNext"><i class="fas fa-forward"></i></button>
                    <button id="closeFull"><i class="fas fa-times"></i></button></div>
                </div>
            </div>`;
        }

        function renderBottomNav() {
            return `<div class="bottom-nav">
                ${['home','search','library','upload','profile'].map(opt => `<div class="nav-item ${currentView===opt?'active':''}" data-nav="${opt}"><i class="fas ${opt==='home'?'fa-home':opt==='search'?'fa-search':opt==='library'?'fa-book':opt==='upload'?'fa-upload':'fa-user'}"></i><span>${opt}</span></div>`).join('')}
            </div>`;
        }

        function attachGlobalEvents() {
            document.querySelectorAll('[data-nav]').forEach(el => el.addEventListener('click', (e) => { currentView = el.dataset.nav; render(); }));
            document.querySelectorAll('.song-card').forEach(card => {
                card.addEventListener('click', (e) => { const id = card.dataset.songId; if(id) playSongById(id); });
            });
            document.querySelectorAll('[data-play]').forEach(btn => btn.addEventListener('click', (e) => { e.stopPropagation(); playSongById(btn.dataset.play); }));
            document.querySelectorAll('[data-fav]').forEach(btn => btn.addEventListener('click', async (e) => {
                e.stopPropagation(); const sid = btn.dataset.fav;
                if (!currentUser) return showToast("Login first", true);
                const favRef = doc(db, "favorites", currentUser.uid);
                if (favoritesCache.includes(sid)) {
                    await updateDoc(favRef, { songIds: arrayRemove(sid) });
                } else {
                    await setDoc(favRef, { songIds: arrayUnion(sid) }, { merge: true });
                }
                loadFavorites(); render();
            }));
            document.getElementById('logoutBtn')?.addEventListener('click', () => signOut(auth));
            document.getElementById('themeToggle')?.addEventListener('click', () => { darkMode = !darkMode; document.body.style.background = darkMode ? 'radial-gradient(circle at 10% 20%, #12121e, #03030a)' : '#f0f0f0'; });
            document.getElementById('globalSearch')?.addEventListener('input', (e) => {
                const term = e.target.value.toLowerCase();
                const filtered = songsCache.filter(s => s.title.toLowerCase().includes(term) || s.artist.toLowerCase().includes(term));
                document.getElementById('viewContainer').innerHTML = `<div class="grid-2">${filtered.map(songCard).join('')}</div>`;
            });
            document.getElementById('uploadSongBtn')?.addEventListener('click', async () => {
                const file = document.getElementById('songFile').files[0];
                if (!file) return showToast("Select MP3", true);
                const title = document.getElementById('songTitle').value;
                const artist = document.getElementById('songArtist').value;
                const genre = document.getElementById('songGenre').value;
                const cover = document.getElementById('coverImage').files[0];
                await uploadSong(file, title, artist, genre, cover);
            });
            document.getElementById('miniPlayer')?.addEventListener('click', () => { fullPlayerOpen = true; render(); });
            document.getElementById('expandPlayer')?.addEventListener('click', () => { fullPlayerOpen = true; render(); });
            document.getElementById('closeFull')?.addEventListener('click', () => { fullPlayerOpen = false; render(); });
            const fullPlay = document.getElementById('fullPlayPause');
            if (fullPlay) fullPlay.onclick = () => { isPlaying ? audio.pause() : audio.play(); isPlaying = !isPlaying; render(); };
            const fullPrev = document.getElementById('fullPrev'); if(fullPrev) fullPrev.onclick = prevSong;
            const fullNext = document.getElementById('fullNext'); if(fullNext) fullNext.onclick = nextSong;
            const miniPP = document.getElementById('miniPlayPause'); if(miniPP) miniPP.onclick = (e) => { e.stopPropagation(); isPlaying ? audio.pause() : audio.play(); isPlaying = !isPlaying; render(); };
            audio.ontimeupdate = () => { if(fullPlayerOpen && audio.duration) { const percent = (audio.currentTime/audio.duration)*100; document.getElementById('fullProgress')?.setAttribute('value', percent); document.getElementById('fullTime').innerHTML = `${Math.floor(audio.currentTime)}/${Math.floor(audio.duration)}`; } };
        }

        // Auth state listener
        onAuthStateChanged(auth, async (user) => {
            currentUser = user;
            if (user) {
                await loadSongs();
                await loadArtists();
                await loadPlaylists();
                await loadFavorites();
            }
            render();
        });

        // Add styles (inject)
        const style = document.createElement('style');
        style.textContent = `
            *{ margin:0; padding:0; box-sizing:border-box; font-family: 'Inter', sans-serif; }
            body { background: radial-gradient(circle at 10% 20%, #12121e, #03030a); color:white; padding-bottom:80px; }
            .app { max-width:1400px; margin:0 auto; padding:1rem; }
            .glass-card { background: rgba(20,20,35,0.6); backdrop-filter: blur(12px); border:1px solid rgba(255,255,255,0.1); border-radius:1.5rem; }
            .btn-primary { background:#ff8c00; border:none; padding:0.7rem 1.5rem; border-radius:2rem; font-weight:600; color:white; cursor:pointer; }
            .btn-outline { background:transparent; border:1px solid #ff8c00; padding:0.7rem 1.5rem; border-radius:2rem; color:#ff8c00; cursor:pointer; }
            .horizontal-scroll { display:flex; gap:1rem; overflow-x:auto; padding-bottom:0.5rem; }
            .song-card, .artist-card { background: rgba(0,0,0,0.4); border-radius:1rem; padding:0.7rem; min-width:140px; cursor:pointer; transition:0.1s; }
            .song-card img, .artist-card img { width:100%; aspect-ratio:1; object-fit:cover; border-radius:0.8rem; }
            .section-title { font-size:1.3rem; margin:1rem 0 0.5rem; font-weight:700; }
            .bottom-nav { position:fixed; bottom:0; left:0; right:0; background:rgba(10,10,20,0.9); backdrop-filter:blur(20px); display:flex; justify-content:space-around; padding:0.7rem; border-top:1px solid rgba(255,255,255,0.1); z-index:100; }
            .nav-item { display:flex; flex-direction:column; align-items:center; color:#aaa; cursor:pointer; font-size:0.7rem; }
            .nav-item.active { color:#ff8c00; }
            .mini-player { position:fixed; bottom:70px; left:0; right:0; background:rgba(0,0,0,0.8); backdrop-filter:blur(16px); padding:0.5rem 1rem; display:flex; align-items:center; gap:1rem; cursor:pointer; z-index:99; }
            .player-modal { position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.95); z-index:200; display:flex; align-items:center; justify-content:center; backdrop-filter:blur(20px); }
            .grid-2 { display:grid; grid-template-columns:repeat(auto-fill, minmax(150px,1fr)); gap:1rem; }
            input, select { background:rgba(255,255,255,0.1); border:1px solid rgba(255,255,255,0.2); border-radius:2rem; padding:0.6rem 1rem; color:white; margin-bottom:0.5rem; width:100%; }
            .equalizer-bar { width:5px; height:20px; background:#ff8c00; animation: bounce 0.6s infinite alternate; }
            @keyframes bounce { 0% { height:10px; } 100% { height:30px; } }
            .genre-pill { background:rgba(255,140,0,0.2); padding:0.3rem 1rem; border-radius:2rem; cursor:pointer; }
        `;
        document.head.appendChild(style);
        // Inject root and initial render
        const rootDiv = document.createElement('div');
        rootDiv.id = 'root';
        document.body.appendChild(rootDiv);
        render();
    </script>
</head>
<body></body>
</html>
